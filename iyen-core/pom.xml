<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.holon-platform.vaadin</groupId>
		<artifactId>holon-vaadin-flow-root</artifactId>
		<version>12.0.1-SNAPSHOT</version>
	</parent>

	<groupId>com.iyensoft.vaadin</groupId>
	<artifactId>iyen-core</artifactId>
	<packaging>jar</packaging>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>IyenSoft Vaadin Flow component library</description>

	<url>https://github.com/vaithu/holon-vaadin-flow</url>
	<inceptionYear>2024</inceptionYear>

	<!-- This module is authored and maintained independently of the upstream
	     Holon Platform project, so it overrides the inherited provenance
	     metadata rather than claiming to be published by them. -->
	<organization>
		<name>IyenSoft</name>
		<url>https://github.com/vaithu</url>
	</organization>

	<developers>
		<developer>
			<id>vaithu</id>
			<organization>IyenSoft</organization>
			<organizationUrl>https://github.com/vaithu</organizationUrl>
		</developer>
	</developers>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/vaithu/holon-vaadin-flow/issues</url>
	</issueManagement>

	<scm>
		<connection>scm:git:https://github.com/vaithu/holon-vaadin-flow.git</connection>
		<developerConnection>scm:git:https://github.com/vaithu/holon-vaadin-flow.git</developerConnection>
		<url>https://github.com/vaithu/holon-vaadin-flow/tree/main/iyen-core</url>
	</scm>

	<dependencies>

		<!-- Holon Vaadin Flow core. This dependency is strictly one-way:
		     com.iyensoft may use com.holonplatform, never the reverse. -->
		<dependency>
			<groupId>com.holon-platform.vaadin</groupId>
			<artifactId>holon-vaadin-flow</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Servlet API (provided scope is not transitive) -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Optional Collaboration Engine (optional scope is not transitive) -->
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>collaboration-engine</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Compile-time utilities -->
		<dependency>
			<groupId>org.jetbrains</groupId>
			<artifactId>annotations</artifactId>
			<scope>compile</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.github.spotbugs</groupId>
			<artifactId>spotbugs-annotations</artifactId>
			<version>4.10.3</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>com.holon-platform.vaadin</groupId>
			<artifactId>holon-vaadin-flow</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.holon-platform.jdbc</groupId>
			<artifactId>holon-datastore-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>vaadin-testbench-unit-junit6</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- JDK9 Automatic-Module-Name -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>com.iyensoft.vaadin.flow</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
