<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.holon-platform</groupId>
		<artifactId>parent</artifactId>
		<version>2.0.2</version>
	</parent>

	<groupId>com.holon-platform.vaadin</groupId>
	<artifactId>holon-vaadin-flow-root</artifactId>
	<version>12.0.1-SNAPSHOT</version>

	<packaging>pom</packaging>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>Holon Vaadin Flow root pom</description>

	<url>https://holon-platform.com</url>

	<organization>
		<name>The Holon Platform</name>
		<url>https://holon-platform.com</url>
	</organization>

	<licenses>
		<license>
			<name>Apache License Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Holon development team</name>
			<email>dev@holon-platform.com</email>
			<organization>The Holon Platform</organization>
			<organizationUrl>https://holon-platform.com</organizationUrl>
		</developer>
	</developers>

	<issueManagement>
		<url>https://github.com/vaithu/holon-vaadin-flow/issues</url>
		<system>GitHub Issues</system>
	</issueManagement>

	<scm>
		<connection>scm:git:https://github.com/vaithu/holon-vaadin-flow.git</connection>
		<url>https://github.com/vaithu/holon-vaadin-flow</url>
		<developerConnection>scm:git:https://github.com/vaithu/holon-vaadin-flow.git</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<java.version>25</java.version>
		<maven.compiler.release>25</maven.compiler.release>
		<maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>

		<!-- Holon core -->
		<holon.core.version>12.0.0</holon.core.version>

		<!-- Vaadin -->
		<vaadin.version>25.3.0</vaadin.version>
		<spring-boot.version>4.1.1</spring-boot.version>
		<junit.jupiter.version>6.1.3</junit.jupiter.version>

		<!-- Servlet API — must match what vaadin flow-server 25.3.x declares (6.1.0 / Jakarta EE 11). -->
		<servlet.version>6.1.0</servlet.version>

		<holon.jdbc.datastore.version>12.0.0</holon.jdbc.datastore.version>
		<holon.jpa.datastore.version>12.0.0</holon.jpa.datastore.version>

		<!-- line-awesome (latest; built against Vaadin 24.2.0 but used as pure CSS/font static assets  no Java API coupling) -->
		<line-awesome.version>2.1.0</line-awesome.version>

		<!-- Mockito (test) -->
		<mockito.version>5.23.0</mockito.version>
		<lombok.version>1.18.38</lombok.version>
		<jetbrains.annotations.version>26.0.2</jetbrains.annotations.version>
		<guava.version>33.7.1-jre</guava.version>

		<!-- HikariCP — managed explicitly for version transparency and easy CVE override.
		     Spring Boot 4.1.1 manages HikariCP 7.0.2 via spring-boot-starter-jdbc; this pin keeps
		     the project on the 6.x line. No known CVEs as of 2026-07-10; bump if a CVE arises. -->
		<hikaricp.version>6.3.0</hikaricp.version>

		<!-- CVE-patched dependency versions -->
		<!-- h2: fixes CVE-2021-23463, CVE-2021-42392, CVE-2022-23221, CVE-2022-45868 -->
		<h2.version>2.3.232</h2.version>
		<!-- assertj: fixes CVE-2026-24400 (XXE in isXmlEqualTo) -->
		<assertj.version>3.27.7</assertj.version>
		<!-- spring-security: version managed by the spring-boot-dependencies BOM import below
		     (Spring Boot 4.1.1 -> Spring Security 7.1.1). Pin here only to override a CVE. -->
		<!-- logback: 1.5.38 is the version managed by Spring Boot 4.1.1 and the latest available;
		     CVE-2026-1225 is flagged as 'Insufficient Information' (GHSA-qqpg-mvqg-649v) with no
		     confirmed fix in any 1.5.x release yet. Monitor for a patched release. -->
		<logback.version>1.5.38</logback.version>
		<!-- snakeyaml: fixes CVE-2022-1471 (Constructor RCE) -->
		<snakeyaml.version>2.6</snakeyaml.version>
		<!-- commons-lang3: fixes CVE-2025-48924 -->
		<commons-lang3.version>3.20.0</commons-lang3.version>

        <!-- Code quality plugin versions -->
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <maven-pmd-plugin.version>3.26.0</maven-pmd-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>

	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- JUnit — imported first so that all JUnit artifacts (jupiter + platform) resolve to a
			     single version. Vaadin 25.3 manages JUnit through junit-bom; importing it here avoids
			     mixing junit-jupiter-engine with an older junit-platform-commons from the Spring Boot
			     BOM, which fails at runtime with IllegalAccessError. -->
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.jupiter.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Spring Boot dependency versions -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Vaadin dependency versions -->
			<dependency>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-bom</artifactId>
				<version>${vaadin.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Holon modules -->
			<dependency>
				<groupId>com.holon-platform.core</groupId>
				<artifactId>holon-core</artifactId>
				<version>${holon.core.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.core</groupId>
				<artifactId>holon-auth</artifactId>
				<version>${holon.core.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.core</groupId>
				<artifactId>holon-spring</artifactId>
				<version>${holon.core.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.core</groupId>
				<artifactId>holon-spring-boot</artifactId>
				<version>${holon.core.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.core</groupId>
				<artifactId>holon-starter</artifactId>
				<version>${holon.core.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.jdbc</groupId>
				<artifactId>holon-datastore-jdbc</artifactId>
				<version>${holon.jdbc.datastore.version}</version>
			</dependency>

			<!-- This project modules -->
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.iyensoft.vaadin</groupId>
				<artifactId>iyen-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-navigator</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-chat</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-ai-assistant</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-spring</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-chartjs</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-vaadin-flow-calendar</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holon-platform.vaadin</groupId>
				<artifactId>holon-starter-vaadin-flow</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Explicit versions not always provided by parent BOMs -->
			<dependency>
				<groupId>org.jetbrains</groupId>
				<artifactId>annotations</artifactId>
				<version>${jetbrains.annotations.version}</version>
			</dependency>
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>${mockito.version}</version>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-api</artifactId>
				<version>${junit.jupiter.version}</version>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit.jupiter.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${guava.version}</version>
			</dependency>
			<dependency>
				<groupId>com.h2database</groupId>
				<artifactId>h2</artifactId>
				<version>${h2.version}</version>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-core</artifactId>
				<version>${assertj.version}</version>
			</dependency>

			<!-- Transitive CVE overrides  force safe versions regardless of what upstream BOMs resolve -->

			<!-- Servlet API — lock to 6.1.0 (Jakarta EE 11) to match vaadin flow-server 25.2.x -->
			<dependency>
				<groupId>jakarta.servlet</groupId>
				<artifactId>jakarta.servlet-api</artifactId>
				<version>${servlet.version}</version>
				<scope>provided</scope>
			</dependency>

			<!-- CVE-2022-1471: SnakeYAML Constructor deserialization RCE, fixed in 2.x -->
			<dependency>
				<groupId>org.yaml</groupId>
				<artifactId>snakeyaml</artifactId>
				<version>${snakeyaml.version}</version>
			</dependency>

			<!-- CVE-2026-1225: logback malicious-config class instantiation, fixed in 1.5.20 -->
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-core</artifactId>
				<version>${logback.version}</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>${logback.version}</version>
			</dependency>

			<!-- CVE-2025-48924: commons-lang3, fixed in 3.18.0 -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${commons-lang3.version}</version>
			</dependency>

			<!-- P6Spy — SQL logging proxy, raw library (Spring Boot 4 compatible) -->
			<dependency>
				<groupId>p6spy</groupId>
				<artifactId>p6spy</artifactId>
				<version>3.9.1</version>
			</dependency>

			<!-- P6Spy DataSource decorator auto-configuration. holon-core declares this as an
			     optional dependency, so applications that want SQL logging must opt in. -->
			<dependency>
				<groupId>com.github.gavlyukovskiy</groupId>
				<artifactId>p6spy-spring-boot-starter</artifactId>
				<version>2.0.1</version>
			</dependency>

			<!-- HikariCP — explicit version pin; Spring Boot 4.1 manages this transitively
			     via spring-boot-starter-jdbc, but declared here for CVE override capability -->
			<dependency>
				<groupId>com.zaxxer</groupId>
				<artifactId>HikariCP</artifactId>
				<version>${hikaricp.version}</version>
			</dependency>

			<!-- Line Awesome icon font  static CSS/font assets only, no Java API coupling -->
			<dependency>
				<groupId>org.parttio</groupId>
				<artifactId>line-awesome</artifactId>
				<version>${line-awesome.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<release>${maven.compiler.release}</release>
						<parameters>true</parameters>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring-boot.version}</version>
				</plugin>
				<plugin>
					<groupId>com.vaadin</groupId>
					<artifactId>vaadin-maven-plugin</artifactId>
					<version>${vaadin.version}</version>
				</plugin>
                <!-- ===== SpotBugs + FindSecBugs ===== -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <failOnError>true</failOnError>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                </plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.1.1</version>
				<configuration>
					<autoVersionSubmodules>true</autoVersionSubmodules>
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<releaseProfiles>release</releaseProfiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<modules>
		<module>core</module>
		<module>iyen-core</module>
		<module>chartjs</module>
		<module>calendar</module>
		<module>navigator</module>
		<module>spring</module>
		<module>spring-boot</module>
		<module>starter</module>
		<module>chat</module>
		<module>ai-assistant</module>
		<module>bom</module>
		<module>documentation</module>
		<module>demo</module>
	</modules>

	<dependencies>
		<!-- JUnit 5 tests -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<profiles>
		<profile>
			<id>release</id>
		</profile>
	</profiles>


</project>
