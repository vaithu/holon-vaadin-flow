<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.holon-platform.vaadin</groupId>
        <artifactId>holon-vaadin-flow-root</artifactId>
        <version>12.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>holon-vaadin-flow-demo</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Holon Vaadin Flow  interactive component showcase</description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <!-- Spring Boot starter: web + Holon boot auto-config + Vaadin -->
        <dependency>
            <groupId>com.holon-platform.vaadin</groupId>
            <artifactId>holon-starter-vaadin-flow</artifactId>
        </dependency>

        <!-- Core module with the components being demonstrated -->
        <dependency>
            <groupId>com.holon-platform.vaadin</groupId>
            <artifactId>holon-vaadin-flow</artifactId>
        </dependency>

        <!-- Chart.js integration -->
        <dependency>
            <groupId>com.holon-platform.vaadin</groupId>
            <artifactId>holon-vaadin-flow-chartjs</artifactId>
        </dependency>

        <!-- Calendar integration -->
        <dependency>
            <groupId>com.holon-platform.vaadin</groupId>
            <artifactId>holon-vaadin-flow-calendar</artifactId>
        </dependency>

        <!-- Live Chat module (also brings in collaboration-engine transitively) -->
        <dependency>
            <groupId>com.holon-platform.vaadin</groupId>
            <artifactId>holon-vaadin-flow-chat</artifactId>
        </dependency>

        <!-- collaboration-engine: explicit dependency for CollaborationFormSupport demo -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>collaboration-engine</artifactId>
        </dependency>

        <!-- Vaadin dev server (dev mode only  excluded from production) -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Data JPA + Hibernate (schema creation via ddl-auto) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Holon JPA Datastore + Spring Boot auto-config (provides the Datastore bean) -->
        <dependency>
            <groupId>com.holon-platform.jpa</groupId>
            <artifactId>holon-datastore-jpa-spring-boot</artifactId>
            <version>${holon.jpa.datastore.version}</version>
        </dependency>

        <!-- Spring Boot persistence module  provides @EntityScan (moved here in Spring Boot 4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>

        <!-- H2 in-memory database (demo persistence) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- P6Spy — SQL logging proxy (raw library, no Spring Boot starter needed).
             Compile scope: the demo provides a custom MessageFormattingStrategy
             (SqlCallerLogFormat) that implements a P6Spy interface. -->
        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
        </dependency>

        <!-- P6Spy DataSource decorator: wraps the DataSource so every statement is logged.
             Declared explicitly because holon-core exposes it as an optional dependency.
             Do NOT combine this with a `jdbc:p6spy:` URL / P6SpyDriver — that double-proxies
             the connection and every statement gets logged twice. -->
        <dependency>
            <groupId>com.github.gavlyukovskiy</groupId>
            <artifactId>p6spy-spring-boot-starter</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Makes the JAR executable via `java -jar` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <nativeImage>
                        <buildArgs>
                            <!-- Vaadin 25 compatibility -->
                            <buildArg>--enable-preview</buildArg>
                            <!-- Sealed interface support -->
                            <buildArg>--enable-url-protocols=https</buildArg>
                            <!-- Better error messages -->
                            <buildArg>--strict-image-heap</buildArg>
                        </buildArgs>
                    </nativeImage>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- JDK9 Automatic-Module-Name -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.holonplatform.vaadin.flow.demo</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Native image profile for Week 4 -->
    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.4</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <metadataRepository>
                                <enabled>true</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <arg>--enable-preview</arg>
                                <arg>--enable-url-protocols=https</arg>
                                <arg>--strict-image-heap</arg>
                                <arg>-H:+AllowIncompleteClasspaths</arg>
                                <arg>-H:IncludeResourceBundles=com.vaadin.flow.server.communication.rpc.messages</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>


