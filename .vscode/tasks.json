{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Compile Demo Module",
			"type": "shell",
			"command": "mvn -pl demo -am compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Compile Core+Demo",
			"type": "shell",
			"command": "mvn -pl core,demo -am compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Compile Core",
			"type": "shell",
			"command": "mvn -pl core -am compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Force Compile Core",
			"type": "shell",
			"command": "mvn -pl core -am compile -DskipTests -Dmaven.compiler.useIncrementalCompilation=false",
			"group": "build"
		},
		{
			"label": "Clean Compile Core",
			"type": "shell",
			"command": "mvn -pl core clean compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Compile Core v2",
			"type": "shell",
			"command": "mvn -pl core clean compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Compile Demo",
			"type": "shell",
			"command": "mvn -pl demo -am compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Clean Compile Demo",
			"type": "shell",
			"command": "mvn -pl demo clean compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Install Core",
			"type": "shell",
			"command": "mvn -pl core install -DskipTests",
			"group": "build"
		},
		{
			"label": "Clean Compile Demo v2",
			"type": "shell",
			"command": "mvn -pl demo clean compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Install Core v2",
			"type": "shell",
			"command": "mvn -pl core install -DskipTests",
			"group": "build"
		},
		{
			"label": "Clean Install Core",
			"type": "shell",
			"command": "mvn -pl core clean install -DskipTests",
			"group": "build"
		},
		{
			"label": "Core Build Check",
			"type": "shell",
			"command": "mvn -pl core clean install -DskipTests",
			"group": "build"
		},
		{
			"label": "Core Compile",
			"type": "shell",
			"command": "mvn -pl core compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Install Core Jar",
			"type": "shell",
			"command": "mvn -pl core jar:jar install:install -DskipTests",
			"group": "build"
		},
		{
			"label": "Demo Compile",
			"type": "shell",
			"command": "mvn -pl demo compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Demo Force Compile",
			"type": "shell",
			"command": "mvn -pl demo process-resources compiler:compile -DskipTests -Dmaven.compiler.useIncrementalCompilation=false",
			"group": "build"
		},
		{
			"label": "Demo Force Compile 2",
			"type": "shell",
			"command": "mvn -pl demo process-resources compiler:compile \"-DskipTests\" \"-Dmaven.compiler.useIncrementalCompilation=false\"",
			"group": "build"
		},
		{
			"label": "Demo Clean Compile",
			"type": "shell",
			"command": "Remove-Item -Recurse -Force demo\\target\\classes; mvn -pl demo compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Core Compile v2",
			"type": "shell",
			"command": "mvn -pl core compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Core Recompile LB",
			"type": "shell",
			"command": "Remove-Item -Force 'core\\target\\classes\\com\\holonplatform\\vaadin\\flow\\components\\ListingBundle.class'; Remove-Item -Force 'core\\target\\classes\\com\\holonplatform\\vaadin\\flow\\components\\ListingBundle$*.class'; mvn -pl core compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Install + Demo Compile",
			"type": "shell",
			"command": "mvn -pl core jar:jar install:install -DskipTests; Remove-Item -Recurse -Force demo\\target\\classes; mvn -pl demo compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Core Compile v3",
			"type": "shell",
			"command": "Remove-Item -Force 'core\\target\\classes\\com\\holonplatform\\vaadin\\flow\\components\\ListingBundle.class'; Remove-Item -Force 'core\\target\\classes\\com\\holonplatform\\vaadin\\flow\\components\\ListingBundle$*.class'; mvn -pl core compile -DskipTests",
			"group": "build"
		},
		{
			"label": "Install + Demo v2",
			"type": "shell",
			"command": "mvn -pl core jar:jar install:install -DskipTests; Remove-Item -Recurse -Force demo\\target\\classes; mvn -pl demo compile -DskipTests",
			"group": "build"
		}
	]
}